# Copy to a private file outside the repo and load it with `set -a; . ./fbguard.env; set +a`.
FBG_PAGE_ID=1234567890
FBG_TOKEN_FILE=.secrets/page_token.enc
FBG_CHANGELOG=changelog.jsonl
# FBG_TOKEN_KEY comes from your secret store, never from this file.
FBG_IDENTITY=page-agent
FBG_SIGNING_KEY=/home/agent/.fbguard/page-agent.key
FBG_TRUSTED_KEYS=/etc/fbguard/trusted_keys
